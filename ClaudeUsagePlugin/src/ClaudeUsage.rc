#pragma code_page(65001)
#include <winres.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_OPTIONS DIALOGEX 0, 0, 240, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Claude Usage — Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Refresh limits:", IDC_STATIC, 10, 13, 90, 10
    COMBOBOX        IDC_INTERVAL, 104, 11, 126, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Anthropic rate-limits this endpoint: polling more often than every 3 minutes may cause HTTP 429 errors. The time until reset in the cells is recalculated every second regardless of this setting.", IDC_STATIC, 10, 32, 220, 40
    DEFPUSHBUTTON   "OK", IDOK, 126, 78, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 180, 78, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Claude Usage — TrafficMonitor plugin"
            VALUE "FileVersion", "1.2.0.0"
            VALUE "InternalName", "ClaudeUsage"
            VALUE "OriginalFilename", "ClaudeUsage.dll"
            VALUE "ProductName", "Claude Usage"
            VALUE "ProductVersion", "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
